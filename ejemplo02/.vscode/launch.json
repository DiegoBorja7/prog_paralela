      "cwd": "${workspaceFolder}/build/Debug",
      "environment": [
        {
          "name": "PATH",
          "value": "D:/Tools/mingw64/bin;D:/Tools/vcpkg-2026.03.18/installed/x64-mingw-dynamic/debug/bin;D:/Tools/vcpkg-2026.03.18/installed/x64-mingw-dynamic/bin;${workspaceFolder}/build/Debug;${workspaceFolder}/build/Release;${env:PATH}"
